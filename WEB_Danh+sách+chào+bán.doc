    <td rowspan=3D"10" class=3D"confluenceTd">BE x=C3=A1c =C4=91=E1=BB=8Bnh=
 kh=C3=A1ch h=C3=A0ng t=E1=BB=AB th=C3=B4ng tin x=C3=A1c th=E1=BB=B1c.<br>
      Nh=E1=BA=ADn productCode t=E1=BB=AB tr=C3=A1i phi=E1=BA=BFu =C4=91ang=
 xem, ki=E1=BB=83m tra tr=C3=A1i phi=E1=BA=BFu t=E1=BB=93n t=E1=BA=A1i v=C3=
=A0 =C4=91ang trong th=E1=BB=9Di gian ch=C3=A0o b=C3=A1n.<br>
      Ki=E1=BB=83m tra l=E1=BA=A7n l=C6=B0=E1=BB=A3t c=C3=A1c =C4=91i=E1=BB=
=81u ki=E1=BB=87n theo th=E1=BB=A9 t=E1=BB=B1 b=C3=AAn d=C6=B0=E1=BB=9Bi; d=
=E1=BB=ABng =E1=BB=9F =C4=91i=E1=BB=81u ki=E1=BB=87n =C4=91=E1=BA=A7u ti=C3=
=AAn kh=C3=B4ng =C4=91=E1=BA=A1t v=C3=A0 tr=E1=BA=A3 v=E1=BB=81 eligible =
=3D false k=C3=A8m reasonCode.<br>
